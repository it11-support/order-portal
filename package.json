{
  "name": "order-portal-tsm",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "fmt": "pnpm format",
    "check:format": "prettier --check .",
    "clean": "turbo clean",
    "db:generate": "cd apps/backend && prisma generate"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.4",
    "@types/cors": "^2.8.19",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@iconify-react/lucide-lab": "^1.0.2",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@typescript-eslint/parser": "^8.72.2",
    "axios": "^1.21.1",
    "express-rate-limit": "^8.7.4",
    "react-router-dom": "^7.18.5",
    "sonner": "2.0.8",
    "swr": "^2.5.1",
    "typescript-eslint": "^8.72.2"
  }
}
