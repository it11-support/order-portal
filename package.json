{
  "name": "mobile-optimized-order-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "fmt": "pnpm format",
    "check:format": "prettier --check .",
    "clean": "turbo clean",
    "db:generate": "cd apps/backend && prisma generate"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@iconify-react/lucide-lab": "^1.0.2",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "react-router-dom": "^7.18.4",
    "swr": "^2.5.1"
  }
}
