{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@hooks/*": ["./src/app/hooks/*"],    
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite.config.ts"],
  "references": [{ "path": "../../packages/shared" }],
  "exclude": ["node_modules", "dist"]
}
