{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@/*": ["./src/*"],
      "@lib": ["./src/lib/index.ts"],
      "@hooks": ["./src/app/hooks/index.ts"],
      "@components": ["./src/app/components/index.ts"],
      "@contexts": ["./src/app/contexts/index.ts"],
      "@layouts": ["./src/app/layouts/index.ts"],
      "@pages": ["./src/app/pages/index.ts"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite.config.ts"],
  "references": [{ "path": "../../packages/shared" }],
  "exclude": ["node_modules", "dist"]
}
