{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@auth": ["./src/auth/index.ts"],
      "@controllers": ["./src/controllers/index.ts"],
      "@routes": ["./src/routes/index.ts"],
      "@utils": ["./src/utils/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tsup.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}