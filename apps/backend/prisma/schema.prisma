generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("roles")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String?    @unique
  password     String     @map("password")
  name         String 
  roleId       Int        @map("role_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id])
  customerId   BigInt?    @unique @map("customer_id")
  
  customer     Customers?  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([username])
  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Customers {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  CardCode      String?   @unique(map: "customers_cardcode_unique") @db.VarChar(15) @map("card_code")
  CardName      String?   @db.VarChar(100) @map("card_name")
  GroupName     String?   @db.VarChar(20)  @map("group_name")
  CntctPrsn     String?   @db.VarChar(90)  @map("cntct_prsn")
  Phone1        String?   @db.VarChar(20)  @map("phone1")
  Cellular      String?   @db.VarChar(50)  @map("cellular")
  SlpCode       Int?      @db.SmallInt     @map("slp_code")
  SalesName     String?   @db.VarChar(155) @map("sales_name")
  Address       String?   @db.VarChar(100) @map("address")
  Block         String?   @db.VarChar(100) @map("block")
  City          String?   @db.VarChar(100) @map("city")
  ZipCode       String?   @db.VarChar(20)  @map("zip_code")
  Country       String?   @db.VarChar(3)   @map("country")
  PaymentTerm   String?   @db.VarChar(100) @map("payment_term")
  PriceList     String?   @db.VarChar(32)  @map("price_list")
  JoinDate      DateTime? @db.Timestamp(0) @map("join_date")
  IndustryC     Int?                       @map("industry_c")
  NonActive     String?   @db.Char(1)      @map("non_active")
                   
  createdAt    DateTime? @db.Timestamp(0)  @map("created_at")
  updatedAt    DateTime? @db.Timestamp(0)  @map("updated_at")

  Subgroup      Subgroups? @relation(fields: [IndustryC], references: [IndCode])

  user         User?

  @@map("customers")
}

model Subgroups {
  IndCode Int    @id  @map("ind_code")
  IndName String @db.VarChar(255) @map("ind_name")
  IndDesc String @db.VarChar(255) @map("ind_desc")

  Customers Customers[]

  @@map("subgroups")
}
